<% var eventTitle = (!!configuration && configuration.title) || 'Sobriety Calculator'; %>
<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: eventTitle }) %>
    <script src="/javascripts/site.js" defer></script>
</head>
<body>
    <main class="shell">
        <%- include('partials/masthead') %>

        <div class="stack">
            <div>
                <span class="eyebrow">Add your clean time</span>
                <h1 class="page-title"><%= eventTitle %></h1>
            </div>

            <% if (error === 'duplicate') { %>
            <div class="alert" role="alert">This clean time has already been submitted.</div>
            <% } %>

            <% if (error === 'invalid-date') { %>
            <div class="alert" role="alert">Please choose a real clean date that is not in the future.</div>
            <% } %>

            <% if (!!configuration && configuration.message) { %>
            <div class="message"><%- configuration.message %></div>
            <% } %>

            <form class="card form" method="post" action="/<%= hash %>/submit" id="cleantime-form">
                <div class="field">
                    <label for="FirstName">First name</label>
                    <input class="input" type="text" name="firstname" id="FirstName" maxlength="50" required autocomplete="given-name" autocapitalize="words"/>
                </div>

                <div class="field">
                    <label for="LastName">Last initial</label>
                    <input class="input" type="text" name="lastname" id="LastName" maxlength="1" required autocomplete="off" autocapitalize="characters"/>
                </div>

                <div class="field">
                    <label for="Email">Email <span class="field__hint">(optional)</span></label>
                    <input class="input" type="email" name="email" id="Email" maxlength="50" autocomplete="email" inputmode="email"/>
                </div>

                <fieldset class="field">
                    <legend>Clean date</legend>
                    <div class="date-fields">
                        <div class="select date-month">
                            <label for="month">Month</label>
                            <select name="month" id="month">
                                <% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach(function(name, i) { %>
                                <option value="<%= i + 1 %>"<%= i === 11 ? ' selected' : '' %>><%= name %></option>
                                <% }); %>
                            </select>
                        </div>

                        <div class="select date-day">
                            <label for="day">Day</label>
                            <select name="day" id="day">
                                <% for (var d = 1; d <= 31; d++) { %>
                                <option value="<%= d %>"<%= d === 31 ? ' selected' : '' %>><%= d %></option>
                                <% } %>
                            </select>
                        </div>

                        <div class="select date-year">
                            <label for="year">Year</label>
                            <select name="year" id="year">
                                <%
                                var inceptionYear = 1953;
                                var thisYear = (new Date()).getFullYear();
                                for (var year = thisYear; year >= inceptionYear; year--) { %>
                                <option value="<%= year %>"<%= year === thisYear ? ' selected' : '' %>><%= year %></option>
                                <% } %>
                            </select>
                        </div>
                    </div>
                </fieldset>

                <button type="submit" class="button--block">Add my clean time</button>
            </form>

            <nav class="event-nav" aria-label="Event pages">
                <a class="button button--secondary" href="/<%= hash %>/total">Total time</a>
                <a class="button button--secondary" href="/<%= hash %>/qr">QR code</a>
            </nav>
        </div>
    </main>
</body>
</html>

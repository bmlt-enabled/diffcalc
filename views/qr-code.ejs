<% var eventTitle = (!!configuration && configuration.title) || 'Sobriety Calculator'; %>
<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: eventTitle + ' - QR Code' }) %>
</head>
<body class="page--stage">
    <main class="stage">
        <%- include('partials/masthead') %>

        <section class="qr">
            <div class="qr__copy">
                <h1 class="stage__title"><%= eventTitle %></h1>
                <p class="qr__cta">Scan to add your clean time to the room’s total</p>
                <% if (!!configuration && configuration.message) { %>
                <div class="message no-print"><%- configuration.message %></div>
                <% } %>
                <p class="muted">Or visit</p>
                <p class="qr__url"><%= formUrl %></p>
            </div>

            <div class="qr__code">
                <img src="<%= qrCodeUrl %>" alt="QR code linking to <%= formUrl %>">
            </div>
        </section>

        <footer class="stage__footer">
            <a href="/<%= hash %>">Back to form</a>
            <a href="/<%= hash %>/total">View total time</a>
        </footer>
    </main>
</body>
</html>

<%
function plural(n, one, many) { return n === 1 ? one : many; }
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Congratulations!' }) %>
    <meta http-equiv="refresh" content="10; url=/<%= hash %>">
</head>
<body>
    <main class="shell">
        <%- include('partials/masthead') %>

        <div class="stack">
            <section class="result rise" aria-labelledby="result-title">
                <span class="eyebrow">You have been clean for</span>
                <h1 id="result-title">Congratulations, <%= allFields.firstname %>!</h1>

                <p class="figure"><%= Number(calculated.totalDays).toLocaleString('en-US') %><span class="figure__unit"><%= plural(calculated.totalDays, 'day', 'days') %></span></p>

                <ul class="breakdown" aria-label="Breakdown">
                    <li><span class="breakdown__value"><%= calculated.years %></span><span class="breakdown__label"><%= plural(calculated.years, 'year', 'years') %></span></li>
                    <li><span class="breakdown__value"><%= calculated.months %></span><span class="breakdown__label"><%= plural(calculated.months, 'month', 'months') %></span></li>
                    <li><span class="breakdown__value"><%= calculated.days %></span><span class="breakdown__label"><%= plural(calculated.days, 'day', 'days') %></span></li>
                </ul>
            </section>

            <div class="redirect-note rise rise--late">
                <div class="countdown" aria-hidden="true"></div>
                <p>Your time has been added. Returning to the form in 10 seconds.</p>
                <p><a href="/<%= hash %>">Return now</a></p>
            </div>
        </div>
    </main>
</body>
</html>

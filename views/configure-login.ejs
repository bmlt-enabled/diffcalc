<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Configure Login' }) %>
</head>
<body>
    <main class="shell">
        <%- include('partials/masthead') %>

        <div class="stack">
            <div>
                <span class="eyebrow">Organisers</span>
                <h1 class="page-title">Sign in to configure</h1>
            </div>

            <% if (error) { %>
            <div class="alert" role="alert"><%= error %></div>
            <% } %>

            <form class="card form" method="post" action="/<%=hash%>/configure/login">
                <div class="field">
                    <label for="password">Password</label>
                    <input class="input" type="password" name="password" id="password" required autofocus autocomplete="current-password">
                </div>

                <button type="submit" class="button--block">Sign in</button>
            </form>

            <p class="redirect-note"><a href="/<%=hash%>">Back to the form</a></p>
        </div>
    </main>
</body>
</html>
